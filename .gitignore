# dependencies
node_modules/

# build output
dist/
coverage/

# local env (never commit secrets)
.env
.env.local
.env.*.local

# logs
npm-debug.log*
*.log

# editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# vite / vitest cache
.vite/
*.tsbuildinfo

package-lock.json
pnpm-lock.yaml

# Leading slash is load-bearing: a bare `data/` matches a directory named `data`
# at ANY depth, which silently swallowed the whole `src/data/` tree. Files added
# before the rule stayed tracked, so the breakage only ever hit NEW files — which
# is how `src/data/ml/m3Tat.ts` and `m5Optimise.ts` came to be imported by
# committed components without ever being committed themselves.
/data/

# local DB dumps (never commit)
backups/
