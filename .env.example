# ─────────────────────────────────────────────────────────────────────────────
# JNPA VTMS — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`. All vars are build-time
# (Vite `import.meta.env`), so anything here ships in the client bundle —
# only put PUBLIC keys / item ids here, never named-user secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Which data adapter the app uses. LEGAL VALUES: mock | live | hybrid
#   mock   = fully offline, zero credentials (default — demos immediately)
#   live   = ArcGIS Stream Layer + Feature Layers + AISStream fallback
#   hybrid = simulated JNPA fleet WITH real aisstream.io vessels layered on top
#            (set VITE_AISSTREAM_TOKEN; real vessels are badged LIVE on map + feed)
#
# Anything else FAILS THE BUILD. It used to fall through to `mock` in silence, so
# a typo (or the `uc3` value that circulated in a programme document) produced a
# dashboard of invented vessels indistinguishable from a working one.
# There is no `uc3` mode: UC-3 gateway data is orthogonal — see VITE_UC3_ENABLED.
VITE_DATA_MODE=mock

# ── ArcGIS platform ──────────────────────────────────────────────────────────
# Portal (ArcGIS Online or Enterprise). Default is ArcGIS Online.
VITE_PORTAL_URL=https://www.arcgis.com

# Public API key — basemaps / geocode only. NOT for org item access.
VITE_ARCGIS_API_KEY=

# OAuth 2.0 named-user app id (registered Application item) — required to load
# PRIVATE org items (e.g. a private WebMap) and private Feature Layers.
# Register: ArcGIS Online → Content → New item → Application → register app.
#   • Add Redirect URIs: your dev origin (e.g. http://localhost:5173) AND your
#     prod host. The app also serves /oauth-callback.html for the pop-up flow.
#   • Copy the resulting App ID (Client ID) here. It is a PUBLIC client id —
#     safe to ship; no client secret is used.
# Leave blank if your WebMap / layers are shared publicly.
VITE_OAUTH_APPID=

# WebMap item shared with the existing Dashboards app
# (current dashboard: 086aad29b91c43428491496776e0d1db).
VITE_WEBMAP_ID=

# ── Live data layer URLs (live mode) ─────────────────────────────────────────
# Velocity-published Stream Layer (live vessel positions, keyed on MMSI).
VITE_STREAM_LAYER_URL=

# Hosted Feature Layer URLs (one per schema).
VITE_FS_VESSELS_URL=
VITE_FS_BERTHS_URL=
VITE_FS_BERTHING_PLAN_URL=
VITE_FS_PORT_CRAFT_URL=
VITE_FS_KPI_SNAPSHOTS_URL=

# ── AISStream.io (live + hybrid modes) ──────────────────────────────────────
# Get a token at https://aisstream.io. Used when the Velocity stream is absent,
# and as one of the two hybrid-mode live sources.
VITE_AISSTREAM_TOKEN=

# ── AISHub public station overlay (hybrid mode) — real JNPA vessels ─────────
# The other hybrid live source: real Nhava Sheva/Mumbai hulls from AISHub's
# public station map (no API username needed). See docs/AISHUB.md.
# NOTE: the public feed is empty for anonymous callers and CORS-blocked, so in
# dev it goes through the Vite proxy and falls back to a bundled JNPA sample.
# Real live AISHub data in production needs an authenticated server-side proxy.
VITE_AISHUB_ENABLED=true
VITE_AISHUB_STATION=2387
VITE_AISHUB_PROXY_BASE=/aishub-proxy
VITE_AISHUB_SAMPLE_FALLBACK=true
# VITE_AISHUB_AOI_BBOX=18.7,72.45,19.25,73.0

# ── Optional: weather/tidal/channel-depth PoC feed ──────────────────────────
VITE_WEATHER_FEED_URL=

# Lookback window (hours) for the history/report widgets. Seed Feature Layers
# hold a few days of fixed-date data, so the default is generous (336h = 14d) to
# keep widgets populated. Narrow once a real live history feed is connected.
VITE_HISTORY_HOURS=

# Serve the dev server over HTTPS so it can be an ArcGIS OAuth redirect URI
# (the app-registration form rejects http://). Self-signed cert; accept the
# one-time browser warning. Leave blank for plain http dev.
VITE_DEV_HTTPS=

# ── Live AIS region (coverage stand-in) ─────────────────────────────────────
# Free public AIS (AISStream.io) has NO receiver coverage over JNPA / Indian
# waters. To show genuine real-time vessels, the live demo re-centres on a
# region that does have coverage (default: Rotterdam). Override to any busy
# port, or point at JNPA once a Velocity/licensed feed (which covers India) is
# configured via VITE_STREAM_LAYER_URL.
#   VITE_AIS_BBOX = "swLat,swLon,neLat,neLon" (AIS subscription box)
VITE_AIS_BBOX=51.85,3.9,52.05,4.5
#   VITE_MAP_CENTER = "lon,lat"
VITE_MAP_CENTER=4.15,51.95
VITE_MAP_ZOOM=11
VITE_LIVE_REGION_LABEL=Rotterdam (live AIS coverage demo)
# "true" only when the region IS the real target (hides the stand-in banner).
VITE_LIVE_REGION_IS_TARGET=

# ── UC-3 shared backend (Shipping Lines) ────────────────────────────────────
# UC-1 reads Shipping Line master data from the SHARED JNPA gateway that UC-3
# hosts (GET /api/shipping-lines/lines). UC-1 and UC-3 are served from different
# origins, so the browser never calls the gateway directly: it fetches a
# RELATIVE /api path which the Vite dev proxy (vite.config.ts) or nginx
# (deploy/nginx.conf) forwards. That keeps it same-origin — no CORS.
#
# Where the proxy forwards to. Dev only — production resolves the gateway in
# nginx, not here. Defaults to http://localhost:8000.
# NOTE: leave this blank only if a gateway really is running on :8000. Otherwise
# Vite cannot connect and answers every /api call with a 500 (its ECONNREFUSED
# response) — which looks like a broken backend, not a missing setting. For the
# deployed gateway use: VITE_GATEWAY_URL=https://traffic-three.searchintech.in
VITE_GATEWAY_URL=
# Master switch. "false" keeps the app fully offline (no UC-3 calls at all).
VITE_UC3_ENABLED=
# Path prefix the app calls. Keep it RELATIVE so the proxy stays in the path;
# an absolute origin here reintroduces CORS. Defaults to /api.
VITE_UC3_API_BASE=/api
# PoC login for POST {VITE_UC3_API_BASE}/auth/login. The gateway's seeded demo
# account is admin/admin (role DTCCC_ADMIN, which /api/shipping-lines allows).
# WARNING: Vite INLINES these into the built bundle — anyone with devtools can
# read them. Demo credential only. Production must move the login server-side
# (real sign-in, or token injection at the nginx tier). Never commit real
# credentials: .env is gitignored, this example file is not.
VITE_UC3_USERNAME=
VITE_UC3_PASSWORD=

# ── Live AIS overlay (real vessels, via the UC-3 gateway) ───────────────────
# Powers the "Live AIS" button on the 2D map and the 3D scene. The gateway
# proxies MarineTraffic's tile API for the JNPA/Mumbai area and returns
# normalised positions: GET {VITE_UC3_API_BASE}/marine/vessels/live (bearer
# required — it reuses the UC-3 login above, so no extra credential here).
# Nothing is persisted server-side; the gateway caches upstream for 60 s.
# Requires VITE_UC3_ENABLED to be on. See docs/LIVE_AIS.md.
VITE_LIVE_AIS_ENABLED=false
# Poll period in ms. Clamped to a 60 s floor — that is the gateway's own cache
# TTL, so polling faster only re-fetches identical rows.
VITE_LIVE_AIS_POLL_MS=60000

# ── NLDS Logistics Data Bank (container track by id) ────────────────────────
# Powers Vessels ▸ Track by Container — same guest auth as ldb.co.in searate:
#   1) GET  /ldb-proxy/apigateway/otp-sms/generate?mobileNo=…
#   2) GET  /ldb-proxy/apigateway/otp-sms/verify?mobileNo=…&otp=… → jwtToken
#   3) POST /ldb-proxy/apigateway/track/cntr/?cntrNo=…&mobileNo=…
#      Authorization: Bearer <searateToken>
# One OTP session tracks ANY container until the JWT expires (401).
# Public UI: https://ldb.co.in/ldb/searate/44/CCLU7468361
VITE_LDB_ENABLED=true
VITE_LDB_PROXY_BASE=/ldb-proxy
# Optional: paste sessionStorage.searateToken from an LDB tab (bootstrap only).
VITE_LDB_ACCESS_TOKEN=
# Default mobile shown on the OTP form.
VITE_LDB_MOBILE_NO=
# Demo sample for CCLU7468361 only when live track fails.
VITE_LDB_SAMPLE_FALLBACK=true
