# ─────────────────────────────────────────────────────────────────────────────
# JNPA VTMS — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`. All vars are build-time
# (Vite `import.meta.env`), so anything here ships in the client bundle —
# only put PUBLIC keys / item ids here, never named-user secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Which data adapter the app uses.
#   mock   = fully offline, zero credentials (default — demos immediately)
#   live   = ArcGIS Stream Layer + Feature Layers + AISStream fallback
#   hybrid = simulated JNPA fleet WITH real aisstream.io vessels layered on top
#            (set VITE_AISSTREAM_TOKEN; real vessels are badged LIVE on map + feed)
VITE_DATA_MODE=mock

# ── ArcGIS platform ──────────────────────────────────────────────────────────
# Portal (ArcGIS Online or Enterprise). Default is ArcGIS Online.
VITE_PORTAL_URL=https://www.arcgis.com

# Public API key — basemaps / geocode only. NOT for org item access.
VITE_ARCGIS_API_KEY=

# OAuth 2.0 named-user app id (registered Application item) — required to load
# PRIVATE org items (e.g. a private WebMap) and private Feature Layers.
# Register: ArcGIS Online → Content → New item → Application → register app.
#   • Add Redirect URIs: your dev origin (e.g. http://localhost:5173) AND your
#     prod host. The app also serves /oauth-callback.html for the pop-up flow.
#   • Copy the resulting App ID (Client ID) here. It is a PUBLIC client id —
#     safe to ship; no client secret is used.
# Leave blank if your WebMap / layers are shared publicly.
VITE_OAUTH_APPID=

# WebMap item shared with the existing Dashboards app
# (current dashboard: 086aad29b91c43428491496776e0d1db).
VITE_WEBMAP_ID=

# ── Live data layer URLs (live mode) ─────────────────────────────────────────
# Velocity-published Stream Layer (live vessel positions, keyed on MMSI).
VITE_STREAM_LAYER_URL=

# Hosted Feature Layer URLs (one per schema).
VITE_FS_VESSELS_URL=
VITE_FS_BERTHS_URL=
VITE_FS_BERTHING_PLAN_URL=
VITE_FS_PORT_CRAFT_URL=
VITE_FS_KPI_SNAPSHOTS_URL=

# ── AISStream.io (live + hybrid modes) ──────────────────────────────────────
# Get a token at https://aisstream.io. Used when the Velocity stream is absent,
# and as one of the two hybrid-mode live sources.
VITE_AISSTREAM_TOKEN=

# ── AISHub public station overlay (hybrid mode) — real JNPA vessels ─────────
# The other hybrid live source: real Nhava Sheva/Mumbai hulls from AISHub's
# public station map (no API username needed). See docs/AISHUB.md.
# NOTE: the public feed is empty for anonymous callers and CORS-blocked, so in
# dev it goes through the Vite proxy and falls back to a bundled JNPA sample.
# Real live AISHub data in production needs an authenticated server-side proxy.
VITE_AISHUB_ENABLED=true
VITE_AISHUB_STATION=2387
VITE_AISHUB_PROXY_BASE=/aishub-proxy
VITE_AISHUB_SAMPLE_FALLBACK=true
# VITE_AISHUB_AOI_BBOX=18.7,72.45,19.25,73.0

# ── Optional: weather/tidal/channel-depth PoC feed ──────────────────────────
VITE_WEATHER_FEED_URL=

# Lookback window (hours) for the history/report widgets. Seed Feature Layers
# hold a few days of fixed-date data, so the default is generous (336h = 14d) to
# keep widgets populated. Narrow once a real live history feed is connected.
VITE_HISTORY_HOURS=

# Serve the dev server over HTTPS so it can be an ArcGIS OAuth redirect URI
# (the app-registration form rejects http://). Self-signed cert; accept the
# one-time browser warning. Leave blank for plain http dev.
VITE_DEV_HTTPS=

# ── Live AIS region (coverage stand-in) ─────────────────────────────────────
# Free public AIS (AISStream.io) has NO receiver coverage over JNPA / Indian
# waters. To show genuine real-time vessels, the live demo re-centres on a
# region that does have coverage (default: Rotterdam). Override to any busy
# port, or point at JNPA once a Velocity/licensed feed (which covers India) is
# configured via VITE_STREAM_LAYER_URL.
#   VITE_AIS_BBOX = "swLat,swLon,neLat,neLon" (AIS subscription box)
VITE_AIS_BBOX=51.85,3.9,52.05,4.5
#   VITE_MAP_CENTER = "lon,lat"
VITE_MAP_CENTER=4.15,51.95
VITE_MAP_ZOOM=11
VITE_LIVE_REGION_LABEL=Rotterdam (live AIS coverage demo)
# "true" only when the region IS the real target (hides the stand-in banner).
VITE_LIVE_REGION_IS_TARGET=
