# ─────────────────────────────────────────────────────────────────────────────
# JNPA VTMS — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`. All vars are build-time
# (Vite `import.meta.env`), so anything here ships in the client bundle —
# only put PUBLIC keys / item ids here, never named-user secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Which data adapter the app uses.
#   mock = fully offline, zero credentials (default — demos immediately)
#   live = ArcGIS Stream Layer + Feature Layers + AISStream fallback
VITE_DATA_MODE=mock

# ── ArcGIS platform ──────────────────────────────────────────────────────────
# Portal (ArcGIS Online or Enterprise). Default is ArcGIS Online.
VITE_PORTAL_URL=https://www.arcgis.com

# Public API key — basemaps / geocode only. NOT for org item access.
VITE_ARCGIS_API_KEY=

# OAuth 2.0 named-user app id (registered app item) — for org Feature Layers.
VITE_OAUTH_APPID=

# WebMap item shared with the existing Dashboards app
# (current dashboard: 086aad29b91c43428491496776e0d1db).
VITE_WEBMAP_ID=

# ── Live data layer URLs (live mode) ─────────────────────────────────────────
# Velocity-published Stream Layer (live vessel positions, keyed on MMSI).
VITE_STREAM_LAYER_URL=

# Hosted Feature Layer URLs (one per schema).
VITE_FS_VESSELS_URL=
VITE_FS_BERTHS_URL=
VITE_FS_BERTHING_PLAN_URL=
VITE_FS_PORT_CRAFT_URL=
VITE_FS_KPI_SNAPSHOTS_URL=

# ── AISStream.io fallback (free open-source AIS WebSocket) ───────────────────
# Get a token at https://aisstream.io. Used when the Velocity stream is absent.
VITE_AISSTREAM_TOKEN=

# ── Optional: weather/tidal/channel-depth PoC feed ──────────────────────────
VITE_WEATHER_FEED_URL=
